# Server
PORT=8080
DATA_DIR=./data
AGENTEVAL_HOST=127.0.0.1
AGENTEVAL_AUTH=0
AGENTEVAL_PIPELINE_TICK_MS=3000

# Container runtime. Podman is the supported backend.
AGENTEVAL_PODMAN=1
AGENTEVAL_PODMAN_SUDO=0

# Model provider for the evaluated agent.
AGENTEVAL_EVAL_API_TYPE=openai
AGENTEVAL_EVAL_BASE_URL=
AGENTEVAL_EVAL_API_KEY_ENV=AGENTEVAL_EVAL_API_KEY
AGENTEVAL_EVAL_API_KEY=
AGENTEVAL_EVAL_MODEL=

# Themis Phase 1 provider.
AGENTEVAL_PHASE1_API_TYPE=openai
AGENTEVAL_PHASE1_BASE_URL=
AGENTEVAL_PHASE1_API_KEY_ENV=AGENTEVAL_PHASE1_API_KEY
AGENTEVAL_PHASE1_API_KEY=
AGENTEVAL_PHASE1_MODEL=
AGENTEVAL_PHASE1_REASONING_EFFORT=max
AGENTEVAL_PHASE1_TIMEOUT_MS=300000
AGENTEVAL_PHASE1_WEB_SEARCH_API_KEY_ENV=SERPER_SEARCH_API_KEY

# Themis Phase 2 provider.
AGENTEVAL_PHASE2_API_TYPE=openai
AGENTEVAL_PHASE2_BASE_URL=
AGENTEVAL_PHASE2_API_KEY_ENV=AGENTEVAL_PHASE2_API_KEY
AGENTEVAL_PHASE2_API_KEY=
AGENTEVAL_PHASE2_MODEL=
AGENTEVAL_PHASE2_REASONING_EFFORT=max
AGENTEVAL_PHASE2_TIMEOUT_MS=300000
AGENTEVAL_PHASE2_WEB_SEARCH_API_KEY_ENV=SERPER_SEARCH_API_KEY

# General-web research. arXiv requires no key and runs alongside Serper.
SERPER_SEARCH_API_KEY=
THEMIS_WEB_SEARCH_PROVIDERS=serper,arxiv,reader
