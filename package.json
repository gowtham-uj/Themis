{
  "name": "agenteval",
  "version": "0.0.0",
  "private": true,
  "description": "API-only agent evaluation backend for adapter versioning, persistent Podman queues, deterministic verification, and immutable eval-result archives.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "AGENTEVAL_PODMAN=1 AGENTEVAL_PODMAN_SUDO=0 vitest run",
    "test:watch": "AGENTEVAL_PODMAN=1 AGENTEVAL_PODMAN_SUDO=0 vitest",
    "serve": "tsx src/cli/serve.ts",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "file:../_inspect/pi/packages/coding-agent",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@quintinshaw/pi-dynamic-workflows": "^3.7.0",
    "@types/yauzl": "^2.10.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "pi-subagents": "^0.54.0",
    "smol-toml": "^1.7.1",
    "tar": "^7.5.22",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  }
}
